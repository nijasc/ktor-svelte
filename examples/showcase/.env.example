# Generated by ktor-svelte from the environment variables the app declares. Do not edit.

# Port the server listens on. A whole number. Default: 8080.
# PORT=8080

# Folder for the database and the uploaded files. Default: build/showcase-data.
# SHOWCASE_DATA=build/showcase-data

# Whether new people can create an account. One of Open, Closed. Default: Open.
# SHOWCASE_REGISTRATION=Open

# Sign-in attempts allowed per minute. A whole number. Default: 10.
# SHOWCASE_LOGIN_ATTEMPTS=10

# Sends the session cookie over plain HTTP too. Either true or false. Default: false.
# SHOWCASE_INSECURE_COOKIES=false

# Public address of the site, for the sitemap. Optional.
# SHOWCASE_SITE_URL=https://showcase.example.com

# Name shown in the header. Default: ktor-svelte showcase.
# APP_NAME=ktor-svelte showcase

# How long someone stays signed in, in seconds. A whole number. Default: 604800.
# SHOWCASE_SESSION_SECONDS=604800

# Hex key that signs the session cookie. Without it, sessions end with each restart. Optional. Secret.
# SESSION_SIGN_KEY=
